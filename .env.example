# Club - PLANTILLA de variables de entorno.
#
# Copiá este archivo como `.env.local` y completá los valores AHÍ.
# `.env.local` lo ignora Git. NUNCA pongas valores reales en este archivo.
# En docs/setup/supabase.md se explica de dónde sale cada valor.

# --- Supabase -------------------------------------------------------------

# URL del proyecto (pública: no pasa nada si el navegador la conoce).
NEXT_PUBLIC_SUPABASE_URL=

# Clave "publishable" (antes llamada "anon"). Es pública por diseño: solo es
# segura porque Row Level Security (RLS) protege cada tabla.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave "secret" (antes llamada "service_role"). SALTEA RLS.
# Solo en el servidor. NUNCA debe empezar con NEXT_PUBLIC_ ni importarse desde
# código que corra en el navegador.
SUPABASE_SECRET_KEY=

# --- Aplicación -----------------------------------------------------------

# URL base de la app (para armar links, como la URL del tag NFC).
APP_BASE_URL=http://localhost:3000

# Zona horaria por defecto para reglas de negocio (cumpleaños, inactividad,
# reportes).
APP_DEFAULT_TIMEZONE=America/Argentina/Cordoba

# --- Mensajería -----------------------------------------------------------

# Proveedor activo: "simulator" (desarrollo) o "whatsapp" (futuro, API oficial
# de WhatsApp Business Platform).
MESSAGING_PROVIDER=simulator

# Las credenciales del proveedor real de WhatsApp se agregarán acá en la etapa
# en que se construya esa integración. Vacío a propósito por ahora.
